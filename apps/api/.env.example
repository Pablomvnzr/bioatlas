DATABASE_URL=postgres://bioatlas:bioatlas_local@localhost:5432/bioatlas
PORT=3000
HOST=0.0.0.0
# Videos: habilitar después de iniciar docker compose --profile media up -d
MONGODB_URI=
MONGODB_DATABASE=bioatlas
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=data/videos
# Para Google Cloud Storage, cambiar MEDIA_STORAGE=gcs y usar credenciales ADC.
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
# Nube gratuita: MEDIA_STORAGE=supabase. Bucket PRIVADO, nunca público.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bioatlas-media
