{
  "name": "@bioatlas/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "db:migrate": "node --env-file=.env scripts/migrate.ts",
    "import:gbif": "node --env-file=.env scripts/import-gbif.ts"
  },
  "dependencies": {
    "@bioatlas/contracts": "workspace:*",
    "@fastify/rate-limit": "^10.0.0",
    "csv-parse": "^6.0.0",
    "fastify": "^5.0.0",
    "leaflet": "1.9.4",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0"
  }
}
